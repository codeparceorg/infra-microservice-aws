terraform {
  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
  backend "s3" {
    use_lockfile = true
    bucket       = "codeparce"
    key          = "devsu/infra-microservice-aws/${TARGET_BRANCH}/terraform.tfstate"
    region       = "${AWS_REGION}"
  }
}

provider "aws" {
  region = "${AWS_REGION}"
}
